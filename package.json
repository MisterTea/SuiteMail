{
  "name": "suitemail",
  "productName": "SuiteMail",
  "description": "Local-first desktop email client",
  "homepage": "https://github.com/MisterTea/SuiteMail",
  "author": "SuiteMail Team",
  "desktopName": "com.suitemail.app.desktop",
  "version": "0.1.7",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/brand-electron.mjs",
    "dev": "vite",
    "dev:desktop": "npm run build:rust && node scripts/brand-electron.mjs && node scripts/dev-desktop.mjs",
    "build:rust": "napi build --platform --manifest-path crates/supermail-core/Cargo.toml --output-dir crates/supermail-core",
    "build:rust:release": "napi build --platform --release --manifest-path crates/supermail-core/Cargo.toml --output-dir crates/supermail-core",
    "build": "tsc && vite build",
    "package": "npm run build:rust:release && npm run build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "test:electron": "node --test electron/*.test.js",
    "test:linux": "node scripts/test-linux-desktop.mjs",
    "test:linux:wayland": "node scripts/test-linux-wayland.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "record:storyboards": "node scripts/record-storyboards.mjs",
    "dev:landing": "npm run dev --prefix landing",
    "submodule:update": "git submodule update --init --recursive",
    "build:android": "node scripts/build-android.mjs",
    "record:android": "tsx scripts/record-android-emulator.ts",
    "test:android": "playwright test --config=playwright.android.config.ts",
    "dev:android": "node scripts/dev-android.mjs",
    "build:ios": "tsc && vite build --mode ios && cap sync ios && bash scripts/build-ios-core.sh",
    "dev:ios": "npm run build:ios && cap open ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@automerge/automerge": "^3.5.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@dnd-kit/core": "^6.3.1",
    "@earendil-works/pi-agent-core": "^1.6.0",
    "@earendil-works/pi-ai": "^1.6.0",
    "@google/generative-ai": "^0.24.1",
    "@kreuzberg/wasm": "4.9.7",
    "@orama/orama": "^3.1.18",
    "@tanstack/react-router": "^1.159.5",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tiptap/extension-color": "^3.19.0",
    "@tiptap/extension-highlight": "^3.19.0",
    "@tiptap/extension-image": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-text-align": "^3.19.0",
    "@tiptap/extension-text-style": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "dompurify": "^3.3.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.563.0",
    "openai": "^6.21.0",
    "openpgp": "^6.3.2",
    "postal-mime": "^4.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-transition-group": "^4.4.5",
    "tesseract-wasm": "^0.11.0",
    "tsdav": "^2.1.8",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@napi-rs/cli": "^3.10.12",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.0.18"
  }
}
