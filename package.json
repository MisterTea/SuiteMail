{
  "name": "suitemail",
  "version": "0.4.21",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "npm run build:rust && concurrently -k \"vite\" \"electron .\"",
    "build:rust": "napi build --platform --manifest-path crates/supermail-core/Cargo.toml",
    "build:rust:release": "napi build --platform --release --manifest-path crates/supermail-core/Cargo.toml",
    "build": "tsc && vite build",
    "package": "npm run build:rust:release && npm run build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "record:storyboards": "node scripts/record-storyboards.mjs",
    "dev:landing": "npm run dev --prefix landing",
    "submodule:update": "git submodule update --init --recursive"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@automerge/automerge": "^3.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@google/generative-ai": "^0.24.1",
    "@tanstack/react-router": "^1.159.5",
    "@tiptap/extension-color": "^3.19.0",
    "@tiptap/extension-highlight": "^3.19.0",
    "@tiptap/extension-image": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-text-align": "^3.19.0",
    "@tiptap/extension-text-style": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "dompurify": "^3.3.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.563.0",
    "openai": "^6.21.0",
    "openpgp": "^6.3.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-transition-group": "^4.4.5",
    "tsdav": "^2.1.8",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.0.18"
  }
}
