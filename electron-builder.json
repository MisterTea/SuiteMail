{
  "appId": "com.suitemail.app",
  "productName": "SuiteMail",
  "protocols": [{ "name": "Email", "schemes": ["mailto"] }],
  "publish": [
    {
      "provider": "github",
      "owner": "MisterTea",
      "repo": "SuiteMail"
    }
  ],
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "splashscreen.html",
    "electron/**/*",
    "assets/**/*",
    "crates/supermail-core/index.*.node",
    "package.json"
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "electron/icons/icon.ico"
  },
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "icon": "electron/icons/icon.icns",
    "category": "public.app-category.productivity"
  },
  "linux": {
    "executableName": "suitemail",
    "syncDesktopName": true,
    "desktop": {
      "entry": {
        "StartupWMClass": "com.suitemail.app",
        "Categories": "Network;Email;",
        "StartupNotify": "true"
      }
    },
    "target": [
      "AppImage",
      "deb"
    ],
    "icon": "electron/icons/icon.png",
    "category": "Network",
    "maintainer": "SuiteMail Team"
  },
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "asarUnpack": [
    "**/*.node"
  ],
  "nsis": {
    "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
  }
}
